# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Cowork / Claude local plugin cache — never belongs in the repo
.claude/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*

# Vite/Vitest regenerate a temp compiled copy of the config on every run when
# the config uses ESM — these are build noise, never source.
vite.config.ts.timestamp-*.mjs
vitest.config.ts.timestamp-*.mjs

# Scratch/verification files agents sometimes leave behind when diffing a
# local file against the live deployed source before pushing.
*.deploy_reconstructed.ts
*_deploy_scratch_reconstructed.ts

# Sandbox FUSE mount blocks unlink() on arbitrary files, so agent sessions
# rename stray scratch files instead of deleting them (see project memory
# novelviz-infra.md) — cover the resulting patterns so they stop showing up
# as untracked noise every session.
*.bak_*
_to_delete/

# supabase CLI regenerates this local project-link cache every session —
# never source, shouldn't have been tracked.
supabase/.temp/

# 2026-08-20 seed-cache reconstruction left these scratch intermediates
# behind in the function dir; FUSE blocks unlink() so they can't be
# deleted from a sandbox session (see novelviz-infra.md). Ignored so they
# stop appearing as untracked noise; safe to delete by hand from Finder.
supabase/functions/seed-cache/array_body.txt
supabase/functions/seed-cache/index_minimal_preview.ts
supabase/functions/seed-cache/index_reconstructed.ts
supabase/functions/seed-cache/remaining_entries.txt
